# ---------------------------------------------------------------------------
# Client Gallery – environment variables
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
# Public base URL of the app (used to build shareable gallery links + CORS origin)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth.js (admin login) ---------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-32-bytes-base64
# Same value; some libraries read NEXTAUTH_SECRET
NEXTAUTH_SECRET=change-me-32-bytes-base64

# --- Client gallery access cookies (separate secret) ------------------------
# Generate with: openssl rand -base64 32
GALLERY_ACCESS_SECRET=change-me-another-32-bytes-base64

# --- Database --------------------------------------------------------------
# Local dev (docker compose up -d db):
DATABASE_URL=postgresql://gallery:gallery@localhost:5432/gallery?schema=public
# Password for the bundled Postgres container (compose reads this file).
POSTGRES_PASSWORD=gallery

# --- Deploy (docker compose up) ------------------------------------------
# Domain Caddy should request an HTTPS certificate for. "localhost" for local.
DOMAIN=localhost

# --- AWS credentials -----------------------------------------------------
# IAM user with the scoped policy in infra/iam-policy.json
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- S3 -----------------------------------------------------------------
S3_BUCKET=my-client-gallery-bucket
# Public base URL for resized images. In production this is the CloudFront
# domain in front of the bucket's cdn/ prefix, e.g. https://dxxxx.cloudfront.net
# For local dev without CloudFront you can point straight at the bucket:
#   https://my-client-gallery-bucket.s3.eu-central-1.amazonaws.com
NEXT_PUBLIC_CDN_URL=https://my-client-gallery-bucket.s3.eu-central-1.amazonaws.com

# --- Email (AWS SES) – OPTIONAL --------------------------------------------
# Leave SES_FROM empty to disable all email notifications globally.
# The per-gallery notification toggles are hidden in the admin UI when this is unset.
SES_FROM=
# Comma-separated default recipients for notifications (can be overridden per gallery)
SES_DEFAULT_TO=
